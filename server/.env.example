PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Local MongoDB (Compass) for Development
MONGO_URI_DEV=mongodb://localhost:27017/my_finance

# MongoDB Atlas for Production (Vercel)
MONGO_URI_PROD=mongodb+srv://<username>:<password>@cluster.mongodb.net/my_finance?retryWrites=true&w=majority

GOOGLE_CLIENT_ID=your_google_client_id_here
JWT_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
